    <ts:testGroup name="date-mixedtz-v01" version="1.1">
        <ts:annotation>
            <ts:documentation>Valid: non-timezoned 2000-12-12 satisfies minInclusive 2000-12-12 at +13:00.</ts:documentation>
        </ts:annotation>
