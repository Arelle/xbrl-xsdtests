            <ts:documentation>Invalid: incomparable non-timezoned instance vs timezoned bound.</ts:documentation>
        </ts:annotation>
        <ts:documentationReference xlink:href="http://www.w3.org/TR/xmlschema11-2/#gDay"/>
        <ts:documentationReference xlink:href="../common/XSD1_1TestCategories.xml#xsd1_1-DateTimeTypes"/>
