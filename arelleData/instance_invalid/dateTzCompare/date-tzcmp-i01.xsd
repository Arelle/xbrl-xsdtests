<?xml version="1.0"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema"
	targetNamespace="http://xstest-tns/arelle_date_tzcmp_i01"
	xmlns:sv="http://xstest-tns/arelle_date_tzcmp_i01">
	
<!-- 
	Test Case Type: Instance Invalid test (Datatypes section 3.3.9 / D.2.1)
	Base Type     : date
	Description   : Counterpart to IBM d3_3_10v01: 2000-12-11+11:00 is less than
			    minInclusive 2000-12-12+13:00 under timezone-aware date ordering.
-->

<simpleType name="dtMin">
	<restriction base="date">
		<minInclusive value="2000-12-12+13:00"/>
	</restriction>
</simpleType>

<element name="root">
	<complexType>
		<sequence>
			<element name="elDate" type="sv:dtMin" minOccurs="1" maxOccurs="unbounded"/>
		</sequence>
	</complexType>
</element>

</schema>
