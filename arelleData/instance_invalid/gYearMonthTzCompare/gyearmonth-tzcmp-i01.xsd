<?xml version="1.0"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema"
	targetNamespace="http://xstest-tns/arelle_gyearmonth_gyearmonth_tzcmp_i01"
	xmlns:sv="http://xstest-tns/arelle_gyearmonth_gyearmonth_tzcmp_i01">

<!-- 
	Test Case Type: Schema for gYearMonth timezone comparison (gyearmonth-tzcmp-i01)
	Base Type     : gYearMonth
-->

<simpleType name="gMin">
	<restriction base="gYearMonth">
		<minInclusive value="2000-12+13:00"/>
	</restriction>
</simpleType>

<element name="root">
	<complexType>
		<sequence>
			<element name="elDate" type="sv:gMin" minOccurs="1" maxOccurs="unbounded"/>
		</sequence>
	</complexType>
</element>

</schema>
