<?xml version="1.0"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema"
	targetNamespace="http://xstest-tns/arelle_gmonth_gmonth_mixedtz_i02"
	xmlns:sv="http://xstest-tns/arelle_gmonth_gmonth_mixedtz_i02">

<!-- 
	Test Case Type: Schema for gMonth timezone comparison (gmonth-mixedtz-i02)
	Base Type     : gMonth
-->

<simpleType name="gMin">
	<restriction base="gMonth">
		<minInclusive value="--12"/>
	</restriction>
</simpleType>

<element name="root">
	<complexType>
		<sequence>
			<element name="elDate" type="sv:gMin" minOccurs="1" maxOccurs="unbounded"/>
		</sequence>
	</complexType>
</element>

</schema>
