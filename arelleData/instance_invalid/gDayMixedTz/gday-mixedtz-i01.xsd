<?xml version="1.0"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema"
	targetNamespace="http://xstest-tns/arelle_gday_mixedtz_i01"
	xmlns:sv="http://xstest-tns/arelle_gday_mixedtz_i01">
	
<!-- 
	Test Case Type: Instance Invalid test (Datatypes section 3.3.13 / D.2.1)
	Base Type     : gDay
	Description   : A timezoned minInclusive bound compared with a non-timezoned
			    instance value whose order is indeterminate.
-->

<simpleType name="gMin">
	<restriction base="gDay">
		<minInclusive value="---16+13:00"/>
	</restriction>
</simpleType>

<element name="root">
	<complexType>
		<sequence>
			<element name="elDate" type="sv:gMin" minOccurs="1" maxOccurs="unbounded"/>
		</sequence>
	</complexType>
</element>

</schema>
