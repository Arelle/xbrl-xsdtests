<?xml version="1.0"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema"
	targetNamespace="http://xstest-tns/arelle_gyear_gyear_tzcmp_v01"
	xmlns:sv="http://xstest-tns/arelle_gyear_gyear_tzcmp_v01">

<!-- 
	Test Case Type: Schema for gYear timezone comparison (gyear-tzcmp-v01)
	Base Type     : gYear
-->

<simpleType name="gMin">
	<restriction base="gYear">
		<minInclusive value="2000+13:00"/>
	</restriction>
</simpleType>

<element name="root">
	<complexType>
		<sequence>
			<element name="elDate" type="sv:gMin" minOccurs="1" maxOccurs="unbounded"/>
		</sequence>
	</complexType>
</element>

</schema>
