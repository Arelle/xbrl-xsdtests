<?xml version="1.0"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema"
	targetNamespace="http://xstest-tns/arelle_date_mixedtz_v01"
	xmlns:sv="http://xstest-tns/arelle_date_mixedtz_v01">
	
<!-- 
	Test Case Type: Schema Valid test (Datatypes section 3.3.9 / D.2.1)
	Base Type     : date
	Description   : A timezoned minInclusive bound compared with a non-timezoned
			    instance on the same calendar day.
-->

<simpleType name="dtMin">
	<restriction base="date">
		<minInclusive value="2000-12-12+13:00"/>
	</restriction>
</simpleType>

<element name="root">
	<complexType>
		<sequence>
			<element name="elDate" type="sv:dtMin" minOccurs="1" maxOccurs="unbounded"/>
		</sequence>
	</complexType>
</element>

</schema>
